# ═══════════════════════════════════════
# Huis ter Huynen – Environment Variables
# ═══════════════════════════════════════
# Kopieer dit bestand naar .env.local
# en vul de waarden in.

# ── Supabase (verplicht voor database) ──
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── Admin beveiliging (verplicht voor /admin) ──
# ADMIN_SECRET bestaat niet meer: het gedeelde wachtwoord is vervangen door
# magic-link-login. Deze twee zijn allebei verplicht.
#
# Wie ze niet zet, kan simpelweg niet inloggen — de code faalt bewust dicht
# (parseSessionCookie geeft null, isAllowedAdminEmail geeft false). Dat is de
# goede faalrichting, maar het ziet er van buiten uit als een stille storing;
# vandaar deze toelichting.

# Komma-gescheiden lijst van adressen die een inloglink mogen aanvragen.
# Staat een adres hier niet in, dan gebeurt er niets — de API antwoordt
# bewust identiek, zodat je er geen adressen mee kunt aftasten.
ADMIN_EMAILS=

# Sleutel waarmee de sessiecookie wordt ondertekend (HMAC-SHA256).
# Minimaal 16 tekens, gebruik er 32+. Genereren: openssl rand -hex 32
# Roteren = alle admins moeten opnieuw inloggen.
ADMIN_SESSION_SECRET=

# ── Gast sessie (verplicht voor /app afscherming) ──
# Min 32 willekeurige tekens. Wordt gebruikt om de HttpOnly stay-cookie
# te signen die /app en /concierge afschermt voor niet-gasten.
# Zet alleen in Vercel env vars (Production + Preview), niet committen.
# Roteren = alle lopende gasten moeten opnieuw via hun welkomstmail-link.
STAY_COOKIE_SECRET=

# ── E-mail (verplicht voor boekingsbevestigingen) ──
RESEND_API_KEY=

# ── AI Chatbot (OpenAI) ──
# Zonder key werkt de chatbot met fallback-antwoorden
OPENAI_API_KEY=

# ── Eigenaar e-mail (notificaties bij boekingen, betalingen, aanvragen) ──
OWNER_EMAIL=

# ── WiFi (gast-app en AI-chatbot) ──
# LET OP: bewust GEEN NEXT_PUBLIC_ prefix. Die zou de waarde tijdens de build
# in de JavaScript bakken die naar elke bezoeker gaat — ook naar wie geen
# verblijf heeft. De gast-app krijgt het wachtwoord via /api/stay, ná
# validatie van het stay-token; de chatbot alleen bij een geldig verblijf.
# Heb je eerder NEXT_PUBLIC_WIFI_PASSWORD gebruikt: verwijder die variabele
# in Vercel én roteer het wifi-wachtwoord — de oude waarde staat in
# gearchiveerde builds en browsercaches.
WIFI_PASSWORD=

# ── Nuki Smart Lock ──
# Zonder keys werkt de deur in demo-modus
NUKI_API_KEY=
# Lodge-specifieke slot-IDs (vul in zodra de Nuki's geplaatst zijn)
NUKI_SMARTLOCK_ID_LODGE_1=   # De Heide
NUKI_SMARTLOCK_ID_LODGE_2=   # De Eik
# Legacy single-lodge fallback — kan worden leeggelaten als beide vars hierboven zijn ingevuld
NUKI_SMARTLOCK_ID=

# ── Booking.com agenda-synchronisatie ──
# iCal-export-URL per lodge. Dit zijn capability-URL's: het token in de URL
# is het enige bewijs van toegang tot de agenda, dus behandel ze als een
# wachtwoord. Stonden eerder hardcoded in src/lib/availability.ts en zijn
# daarom geroteerd. Ontbreken ze, dan toont de kalender alleen onze eigen
# bevestigde reserveringen (geen stille terugval meer).
ICAL_LODGE_1=
ICAL_LODGE_2=

# ── Mollie Betalingen ──
# Zonder key wordt een simpel formulier getoond
MOLLIE_API_KEY=

# ── Google Maps / Business Reviews ──
# Vereist voor het ophalen van Google Business reviews
# Place ID vind je op: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=ChIJEZ3h8BUxyEcRqPvq9qnzXyk

# ── Weer (OpenWeatherMap) ──
# Zonder key wordt een seizoensschatting getoond
OPENWEATHER_API_KEY=

# ── e-Boekhouden integratie ──
# Optioneel — voor automatisch doorboeken van facturen
EBOEKHOUDEN_API_TOKEN=

# ── App URL (gast-app, inclusief pad /concierge) ──
NEXT_PUBLIC_APP_URL=https://huisterhuynen.nl/concierge

# ── Vercel Cron beveiliging ──
# Vercel vult CRON_SECRET automatisch in op het platform.
# Lokaal testen: stel zelf een willekeurige string in.
CRON_SECRET=

# ── IndexNow (optioneel) ──
# Meldt nieuwe/gewijzigde URL's aan bij Bing en Yandex. De sleutel is publiek
# van opzet: hij bewijst domeincontrole doordat hij op ons eigen domein staat,
# en er valt niets mee te doen behalve onze eigen URL's aanmelden. Er zit een
# standaardsleutel in de code; vul dit alleen in als je hem wilt vervangen
# (zet dan ook het bijbehorende bestand in public/).
INDEXNOW_KEY=

# ── Meta Pixel + Conversions API ──
# Zonder Pixel ID + token wordt er niets naar Meta gestuurd (silent no-op).
# Pixel ID: Events Manager → Settings → Pixel ID
# Access token: Events Manager → Settings → Generate access token
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Tijdens setup invullen met Test Events code uit Events Manager → Test Events.
# Daarna LEEG laten — anders zien jouw productie-events er als test-events uit.
META_CAPI_TEST_EVENT_CODE=

# ── Google Search Console (maandelijkse analyse) ──
# Voedt admin → Marketing → Search Console. De cron draait op de 3e van de maand.
#
# Eenmalige inrichting:
#  1. Maak in Google Cloud een project en zet de Search Console API aan.
#  2. Maak een service-account en download de JSON-sleutel.
#  3. Voeg in Search Console het e-mailadres van dat service-account toe als
#     gebruiker op de property (Instellingen → Gebruikers, rechten: volledig).
#  4. Zet de waarden hieronder. GSC_PRIVATE_KEY komt uit het veld private_key
#     van de JSON; laat de \n-tekens staan. In dit bestand hoort de waarde
#     tussen aanhalingstekens; in de Vercel-webinterface juist NIET, daar
#     worden ze onderdeel van de sleutel.
#  5. Eerste keer historie ophalen (Search Console bewaart 16 maanden):
#     curl -H "Authorization: Bearer $CRON_SECRET" \
#       "https://www.huisterhuynen.nl/api/cron/gsc-sync?maanden=16"
#
# GSC_SITE_URL moet exact overeenkomen met de property in Search Console.
# Domein-property: sc-domain:huisterhuynen.nl
# URL-prefix-property: https://www.huisterhuynen.nl/
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:huisterhuynen.nl

# ── Google Analytics 4 (direct, optioneel) ──
# Met dit ID vuurt de app GA4-events rechtstreeks (zelfde patroon als de Meta
# Pixel), consent-gated op de 'statistics'-categorie. Zonder ID: silent no-op.
# LET OP: gebruik OFWEL dit ID OFWEL een GA4-config-tag in GTM — niet beide,
# anders worden page_views dubbel geteld. Mapping: Lead→generate_lead,
# InitiateCheckout→begin_checkout, Subscribe→newsletter_subscribe,
# BookingComRedirect→outbound_ota, PageView→page_view, Purchase→purchase.
NEXT_PUBLIC_GA4_ID=

# ── Google Tag Manager ──
# Web container. Zonder ID wordt er geen GTM script geladen.
NEXT_PUBLIC_GTM_ID=
# Optioneel: 1st-party server-side GTM URL (Cloud Run / Stape) op eigen subdomein.
# Bijv. https://sgtm.huisterhuynen.nl — laadt gtm.js + ns.html via 1st party.
NEXT_PUBLIC_SGTM_URL=

# ── Google Ads ──
# Conversie- en remarketingtag (gtag.js). Het ID uit Google Ads staat als
# default in src/components/tracking/GoogleAds.tsx (AW-18397549973), dus de tag
# gaat ook zonder deze variabele mee. Vul hier alleen iets in als je een ánder
# AW-ID wilt gebruiken; leeg laten verandert niets.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ── Cookie consent ──
# Verhoog dit nummer om alle bezoekers opnieuw toestemming te laten geven.
# Doe dit zodra je een nieuwe categorie of vendor toevoegt.
NEXT_PUBLIC_CONSENT_VERSION=2026.05
